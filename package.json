{
  "name": "retransmit.dev",
  "version": "0.6.0",
  "description": "Node.js SDK for the Retransmit email, SMS and WhatsApp APIs",
  "keywords": [
    "email",
    "sms",
    "messaging-api",
    "retransmit",
    "ses",
    "transactional-email",
    "transactional-sms",
    "whatsapp",
    "whatsapp-cloud-api"
  ],
  "homepage": "https://docs.retransmit.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/retransmit-dev/retransmit-node.git"
  },
  "bugs": {
    "url": "https://github.com/retransmit-dev/retransmit-node/issues"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsup": "^8.5.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@10.27.0",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}
