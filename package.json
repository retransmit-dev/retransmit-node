{
  "name": "retransmit.dev",
  "version": "0.1.0",
  "description": "Node.js SDK for the Retransmit email API",
  "keywords": [
    "email",
    "retransmit",
    "ses",
    "transactional-email"
  ],
  "homepage": "https://docs.retransmit.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jpainam/retransmit.git",
    "directory": "packages/sdk"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "check-types": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@retransmit/config": "workspace:*",
    "@types/node": "catalog:",
    "tsup": "^8.5.0",
    "typescript": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}
